diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..d8656a4
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,33 @@
+# Postgres
+DB_HOST=localhost
+DB_PORT=5432
+DB_USERNAME=postgres
+DB_PASSWORD=postgres
+DB_NAME=job_queue
+DB_SYNC=true
+DB_LOGGING=false
+
+# Redis
+REDIS_HOST=localhost
+REDIS_PORT=6379
+WORKER_CONCURRENCY=5
+
+# Gemini API (free tier: no credit card required)
+# Get a key at https://aistudio.google.com/apikey
+# Verify these model names are still current in Google AI Studio before
+# running — Google has deprecated embedding model names before
+# (e.g. text-embedding-004 was retired Jan 2026 in favor of
+# gemini-embedding-001) and will likely do so again.
+GEMINI_API_KEY=
+GEMINI_EMBEDDING_MODEL=gemini-embedding-001
+GEMINI_COMPLETION_MODEL=gemini-2.5-flash
+
+# Semantic cache tuning
+# Cosine similarity threshold above which a cached response is reused
+# instead of calling the LLM again. 1.0 = exact match only. Start high
+# (0.92-0.95) and tune down only after checking reused responses are
+# actually still valid for the new prompt.
+CACHE_SIMILARITY_THRESHOLD=0.92
+# How long a cache entry stays eligible for reuse, in milliseconds.
+# Default: 24 hours.
+CACHE_TTL_MS=86400000
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..0ea27cd
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,36 @@
+name: CI
+
+on:
+  push:
+    branches: [master]
+  pull_request:
+    branches: [master]
+
+jobs:
+  lint-build-test:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Enable Corepack (pnpm)
+        run: corepack enable
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 24
+          cache: pnpm
+
+      - name: Install dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Lint
+        run: pnpm run lint
+
+      - name: Build
+        run: pnpm run build
+
+      - name: Unit tests
+        run: pnpm test
